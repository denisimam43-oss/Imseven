rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function hasRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && role() in ['OWNER', 'FINANCE', 'AKUNTAN'];
    }
    function isOwner() { return hasRole() && role() == 'OWNER'; }
    function isOwnerOrFinance() { return hasRole() && role() in ['OWNER', 'FINANCE']; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if hasRole();
      allow write: if isOwner();
    }

    // PERUBAHAN: AKUNTAN hanya baca; hapus proyek hanya OWNER
    match /projects/{id} {
      allow read: if hasRole();
      allow create, update: if isOwnerOrFinance();
      allow delete: if isOwner();
    }

    // PERUBAHAN: AKUNTAN hanya baca; transaksi APPROVED terkunci (hanya OWNER yang boleh mengubah)
    match /transactions/{id} {
      allow read: if hasRole();
      allow create: if isOwnerOrFinance()
        && (isOwner() || request.resource.data.get('approval', null) != 'APPROVED');
      allow update: if isOwnerOrFinance()
        && (isOwner()
            || (resource.data.get('approval', null) != 'APPROVED'
                && request.resource.data.get('approval', null) != 'APPROVED'));
      allow delete: if isOwner();
    }

    // PERUBAHAN: AKUNTAN hanya baca
    match /supports/{id} {
      allow read: if hasRole();
      allow create, update: if isOwnerOrFinance();
      allow delete: if isOwner();
    }

    match /auditLog/{id} {
      allow read: if hasRole();
      allow create: if hasRole();
      allow update, delete: if false;
    }

    // BARU: fitur kewajiban & aset tetap
    match /liabilities/{id} {
      allow read: if hasRole();
      allow create, update: if isOwnerOrFinance();
      allow delete: if isOwner();
    }
    match /fixedAssets/{id} {
      allow read: if hasRole();
      allow create, update: if isOwnerOrFinance();
      allow delete: if isOwner();
    }
  }
}
